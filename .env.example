# ==============================================================
# Konfigurasi Environment Docker Sistem Manajemen Skripsi UNRI
# Salin file ini menjadi .env sebelum menjalankan docker-compose:
# cp .env.example .env
# ==============================================================

# Port Mapping ke Komputer Host
APP_PORT=80
API_PORT=5000
DB_PORT_HOST=3306

# Konfigurasi Basis Data MySQL / MariaDB
DB_HOST=db
DB_PORT=3306
DB_NAME=manajemen_skripsi
DB_USER=root
DB_PASSWORD=rootpassword

# Konfigurasi Backend Express
PORT=5000
NODE_ENV=production
